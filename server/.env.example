# Server Configuration
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Nodemailer / SMTP Configuration
# Set these to your live SMTP provider (e.g. Gmail, SendGrid, Mailgun, Amazon SES)
# If left empty, the server operates in safe development logging mode.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Inquiry Notification Recipient
ALERT_RECIPIENT_EMAIL=info@houseofengineers.pk
ALERT_FROM_EMAIL=no-reply@houseofengineers.pk
